{
  "name": "bodega",
  "version": "0.1.0",
  "private": true,
  "description": "Herd immunity for AI store agents",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"tsx watch src/server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "eval": "tsx scripts/eval.ts",
    "compare": "tsx scripts/compare.ts",
    "try": "tsx scripts/try.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@mongodb-js/agent-engine-sdk-memory": "0.11.13",
    "express": "^5.3.0",
    "mongodb": "^7.7.0",
    "nanoid": "^5.1.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
