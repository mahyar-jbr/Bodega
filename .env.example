# Copy to .env and fill in. Never commit .env.
# These names are the starting plan; the architecture may add or rename variables.
# Local development: the prep cluster (bodega-dev), all week and on build day. The deployed app moves to the event's sandbox on build day.
# Single-quote values that contain & or $ (Atlas connection strings do):
# MONGODB_URI='mongodb+srv://...'. Unquoted, loading this file in zsh fails.
MONGODB_URI=
MONGODB_DB=bodega
ANTHROPIC_API_KEY=
# Atlas model API key for Voyage (Organization > Services > Model API Keys)
VOYAGE_API_KEY=
VOYAGE_BASE_URL=https://ai.mongodb.com/v1
VOYAGE_MODEL=voyage-4-lite
SHOPKEEPER_MODEL=claude-sonnet-5-5
GUARD_MODEL=claude-haiku-5-5
LEARNER_MODEL=claude-opus-5-5
# Protects the ops console
OPS_PASSWORD=
# Base URL used in the QR codes
PUBLIC_BASE_URL=http://localhost:3000
# Agent Memory (Atlas Agent Engine): the app's service account and project
AGENTIC_MEMORY_CLIENT_ID=
AGENTIC_MEMORY_CLIENT_SECRET=
AGENTIC_MEMORY_PROJECT_ID=
# Server port (Render sets its own)
PORT=3000
# Held-out cases run at once
EVAL_CONCURRENCY=120
